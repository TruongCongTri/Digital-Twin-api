# Server Configuration
NODE_ENV=development
PORT=5000

# Database Connection (Development)
# Replace <USER>, <PASSWORD>, and <DB_NAME> with your local Postgres credentials
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DB_NAME>?schema=public"

# CORS Configuration (Next.js Frontend)
CLIENT_URL="http://localhost:3000"

# Mật khẩu để mã hóa JWT
JWT_SECRET="super_secret_jwt_key_digital_twin_2026"
JWT_EXPIRES_IN="15m" # Thời gian hết hạn của JWT, có thể là '1h', '30m', '7d', v.v.
JWT_REFRESH_SECRET="super_refresh_secret_jwt_key_digital_twin_2026"
JWT_REFRESH_EXPIRES_IN="7d" # Thời gian hết hạn của Refresh Token, có thể là '30d', '60d', v.v.
BCRYPT_SALT_ROUNDS=12 # Số rounds để bcrypt hash, nên để từ 10 trở lên cho an toàn


REDIS_URL="redis://localhost:6379"

