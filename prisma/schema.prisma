// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  moduleFormat = "cjs"
  // previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

/* ==========================================
 * AUTH & USER MODULE
 * ========================================== */

enum Role {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpType {
  VERIFY_ACCOUNT
  FORGOT_PASSWORD
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  password      String
  fullName      String
  role          Role          @default(USER)
  accountStatus AccountStatus @default(PENDING)
  
  // Auth Tracking Fields
  isEmailVerified     Boolean       @default(false) @map("is_email_verified")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")

  // Relations
  assets        Asset[]       @relation("UserAssets")
  sessions      Session[]     @relation("UserSessions")
  notifications Notification[] 
  scenes        Scene[]       
  annotations   Annotation[]  

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  
  refreshToken String   @unique @map("refresh_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceId     String   @default("unknown") @map("device_id")
  
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at")
  lastActive   DateTime @default(now()) @map("last_active")
  
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Otp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  code      String
  type      OtpType
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
}

/* ==========================================
 * ASSET MODULE
 * ========================================== */

enum AssetStatus {
  PENDING   // Waiting for Admin approval to show on map
  APPROVED  // Visible on map
  REJECTED  // Rejected by Admin
}

enum SyncStatus {
  PENDING     // Waiting in queue
  PROCESSING  // Currently syncing with ArcGIS
  COMPLETED   // Successfully synced and got ArcGIS ID
  FAILED      // Failed to sync
}

enum AssetType {
  SHAPE       // .rvt, .ifc, .zip (3D Models / Geometries)
  ATTRIBUTE   // .xlsx (Tabular data bound to a Shape)
  POINT       // .xlsx (Coordinates X, Y)
}

model Asset {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String      @db.Uuid @map("owner_id")
  
  // Metadata
  name           String
  description    String?     @db.Text
  fileUrl        String      @map("file_url")
  fileType       AssetType   @map("file_type")
  metadata       Json?

  // System & Map Visibility Status
  status         AssetStatus @default(PENDING)

  // ArcGIS Sync Tracking (Replaces Job Module)
  arcgisItemId   String?     @map("arcgis_item_id")
  syncStatus     SyncStatus  @default(PENDING) @map("sync_status")
  syncProgress   Int         @default(0) @map("sync_progress")
  syncError      String?     @db.Text @map("sync_error")
  
  // Self-Relation
  bindToShapeId  String?     @db.Uuid @map("bind_to_shape_id")
  parentShape    Asset?      @relation("ShapeAttributes", fields: [bindToShapeId], references: [id], onDelete: SetNull)
  childData      Asset[]     @relation("ShapeAttributes")

  // Relations
  owner          User        @relation("UserAssets", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("assets")
}

// ==========================================
// NOTIFICATION MODULE
// ==========================================
enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @db.Uuid @map("user_id")
  title           String
  message         String           @db.Text
  type            NotificationType @default(INFO)
  isRead          Boolean          @default(false) @map("is_read")
  
  // Optional linkage to what caused the notification
  relatedEntityId String?          @map("related_entity_id") 

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

// ==========================================
// SCENE & ANNOTATION MODULE
// ==========================================
model Scene {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String       @db.Uuid @map("author_id")
  name            String
  description     String?      @db.Text
  
  // Store the 3D Engine Camera State (x, y, z, pitch, yaw, roll)
  cameraState     Json         @map("camera_state")
  
  // Store which layers/assets are turned on or off
  layerVisibility Json?        @map("layer_visibility")

  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  annotations     Annotation[]

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("scenes")
}

model Annotation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sceneId     String    @db.Uuid @map("scene_id")
  authorId    String    @db.Uuid @map("author_id")
  
  text        String    @db.Text
  // Store XYZ coordinates where the pin is dropped in the 3D space
  position    Json
  
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("annotations")
}