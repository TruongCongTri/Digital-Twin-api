// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  moduleFormat = "cjs"
  // previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetType {
  SHAPE       // .rvt, .ifc, .zip (3D Models / Geometries)
  ATTRIBUTE   // .xlsx (Tabular data bound to a Shape)
  POINT       // .xlsx (Coordinates X, Y)
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum OtpType {
  VERIFY_ACCOUNT
  FORGOT_PASSWORD
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/* ==========================================
 * MODELS
 * ========================================== */

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  password      String
  fullName      String
  role          Role          @default(USER)
  accountStatus AccountStatus @default(PENDING)
  
  // Auth Tracking Fields
  isEmailVerified     Boolean       @default(false) @map("is_email_verified")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")

  // Relations
  assets        Asset[]       @relation("UserAssets")
  sessions      Session[]     @relation("UserSessions")
  workspaces    WorkspaceMember[] @relation("UserWorkspaces")
  sentInvites   WorkspaceInvitation[] @relation("SentInvitations")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  
  refreshToken String   @unique @map("refresh_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceId     String   @default("unknown") @map("device_id")
  
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at")
  lastActive   DateTime @default(now()) @map("last_active")
  
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Otp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  code      String
  type      OtpType
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
}

model Asset {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String      @db.Uuid @map("owner_id")
  
  // Metadata
  name           String
  description    String?     @db.Text
  fileUrl        String      @map("file_url") // S3 or Local storage path
  fileType       AssetType   @map("file_type")
  
  // JSON payload to store { "xCol": "Long", "yCol": "Lat" } for Point Data
  metadata       Json?

  // ArcGIS Sync
  arcgisItemId   String?     @map("arcgis_item_id")
  status         AssetStatus @default(PENDING)
  
  // Self-Relation: Attribute data (.xlsx) can be bound to a Shape layer (.rvt)
  bindToShapeId  String?     @db.Uuid @map("bind_to_shape_id")
  
  // onDelete: SetNull ensures if the Parent Shape is deleted, the tabular data isn't deleted, just unlinked.
  parentShape    Asset?      @relation("ShapeAttributes", fields: [bindToShapeId], references: [id], onDelete: SetNull)
  childData      Asset[]     @relation("ShapeAttributes")

  // Raw Spatial Data (Optional: If you want to store bounding boxes or center points in DB)
  // geom        Unsupported("geometry(Point, 4326)")? 

  // Relations
  owner          User         @relation("UserAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  publishJob     PublishJob?  @relation("AssetJob")
  workspaceId    String?      @db.Uuid @map("workspace_id")
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("assets")
}

model PublishJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // @unique forces the strict 1-to-1 relationship!
  assetId      String    @unique @db.Uuid @map("asset_id")
  asset        Asset     @relation("AssetJob", fields: [assetId], references: [id], onDelete: Cascade)
  
  status       JobStatus @default(PENDING)
  progress     Int       @default(0) // 0 to 100
  errorLog     String?   @db.Text @map("error_log")
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("publish_jobs")
}


model Workspace {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?   @db.Text
  
  // Relations
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  assets      Asset[]   // A workspace now owns the assets!

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid @map("workspace_id")
  userId      String        @db.Uuid @map("user_id")
  role        WorkspaceRole @default(VIEWER)

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation("UserWorkspaces", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt    DateTime      @default(now()) @map("joined_at")

  @@unique([workspaceId, userId]) // A user can only have one role per workspace
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid @map("workspace_id")
  email       String
  role        WorkspaceRole @default(VIEWER)
  token       String        @unique // Cryptographic token sent in email
  status      InviteStatus  @default(PENDING)
  expiresAt   DateTime      @map("expires_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviterId   String        @db.Uuid @map("inviter_id") // The user who sent the invite
  inviter     User          @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("workspace_invitations")
}